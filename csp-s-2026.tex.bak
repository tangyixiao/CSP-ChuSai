% ======================== 一、单项选择题（题头与注意事项后直接开始） ========================
\bigtitle{一、单项选择题（共 15 题，每题 2 分，共计 30 分；每题有且仅有一个正确选项）}

\q{1.} 在 Linux 系统中，如果你想显示当前工作目录的路径，应该使用哪个命令？（\qquad）\\
\opt{A. pwd}
\opt{B. cd}
\opt{C. ls}
\opt{D. echo}

\q{2.} 二进制数 \texttt{10111010} 与 \texttt{01101101} 进行按位与运算，其结果是（\qquad）\\
\opt{A. \texttt{00101001}}
\opt{B. \texttt{00101000}}
\opt{C. \texttt{00011000}}
\opt{D. \texttt{11111111}}

\q{3.} 已知 \texttt{T(1)=1}，且对 \texttt{n >= 2} 有 \texttt{T(n)=T(n/2)+1}，则 \texttt{T(n)} 的数量级为（\qquad）\\
\opt{A. \texttt{O(n)}}
\opt{B. \texttt{O(log n)}}
\opt{C. \texttt{O(n log n)}}
\opt{D. \texttt{O(n\^{}2)}}

\q{4.} 6 名同学围成一圈开会，旋转后相同的坐法视为同一种坐法，则不同的坐法共有（\qquad）\\
\opt{A. 60 种}
\opt{B. 120 种}
\opt{C. 240 种}
\opt{D. 720 种}

\q{5.} 中缀表达式 \texttt{(a+b)*c} 对应的后缀表达式为（\qquad）\\
\opt{A. \texttt{ab+c*}}
\opt{B. \texttt{ab*+c}}
\opt{C. \texttt{abc*+}}
\opt{D. \texttt{+ab*c}}

\q{6.} 具有 \texttt{n} 个顶点的完全图（任意两个不同顶点之间恰有一条边）共有（\qquad）条边\\
\opt{A. \texttt{n(n-1)}}
\opt{B. \texttt{n(n-1)/2}}
\opt{C. \texttt{n\^{}2}}
\opt{D. \texttt{n(n+1)/2}}

\q{7.} 深度为 \texttt{h}（根的深度为 1）的完全二叉树，其结点个数最多为（\qquad）\\
\opt{A. \texttt{2\^{}h-1}}
\opt{B. \texttt{2\^{}(h-1)}}
\opt{C. \texttt{2\^{}h}}
\opt{D. \texttt{2\^{}h+1}}

\q{8.} 对已经有序的数组执行快速排序，若每次划分都选择第一个元素作为基准元素，则其最坏时间复杂度为（\qquad）\\
\opt{A. \texttt{O(n log n)}}
\opt{B. \texttt{O(n\^{}2)}}
\opt{C. \texttt{O(n)}}
\opt{D. \texttt{O(log n)}}

\q{9.} 已知函数 \texttt{int lowbit(int x) \{ return x \& (-x); \}}，则 \texttt{lowbit(10)} 的值为（\qquad）\\
\opt{A. 1}
\opt{B. 2}
\opt{C. 4}
\opt{D. 8}

\q{10.} 设哈希表长为 7，哈希函数为 \texttt{h(x) = x mod 7}，采用线性探查解决冲突。依次插入 10、17、31 的过程中，共发生（\qquad）次冲突\\
\opt{A. 1}
\opt{B. 2}
\opt{C. 3}
\opt{D. 4}

\q{11.} 用 4 对括号可以组成的不同合法括号序列共有（\qquad）个\\
\opt{A. 8}
\opt{B. 10}
\opt{C. 12}
\opt{D. 14}

\q{12.} 关于 Dijkstra 算法，下列说法正确的是（\qquad）\\
\opt{A. 可以处理含负权边的图}
\opt{B. 要求图中所有边权均为非负数}
\opt{C. 可以处理含负权环的图}
\opt{D. 使用二叉堆优化后，时间复杂度仍为 \texttt{O(n\^{}2)}}

\q{13.} 整数 \texttt{a} 在模 \texttt{m} 意义下存在乘法逆元的充要条件是（\qquad）\\
\opt{A. \texttt{m} 是质数}
\opt{B. \texttt{a < m}}
\opt{C. \texttt{a} 与 \texttt{m} 互质}
\opt{D. \texttt{a} 是质数}

\q{14.} 一个有向图存在拓扑排序的充要条件是（\qquad）\\
\opt{A. 该图为有向无环图}
\opt{B. 该图为强连通图}
\opt{C. 图中无重边}
\opt{D. 图中每个顶点的入度均不超过 1}

\q{15.} 在 1 到 100 的整数中，不能被 2、3、5 中任何一个整除的数共有（\qquad）个\\
\opt{A. 26}
\opt{B. 24}
\opt{C. 28}
\opt{D. 32}

