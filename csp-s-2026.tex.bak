% ======================== 二、阅读程序 ========================
\bigtitle{二、阅读程序（程序输入不超过数组或字符串定义的范围；判断题正确填√，错误填×；除特殊说明外，判断题 1.5 分，选择题 3 分，共计 40 分）}

\noindent（1）
\begin{codebox}
\begin{lstlisting}
#include <bits/stdc++.h>
using namespace std;
const int M = 2e6 + 5;
long long A[200005], B[200005], pA[200005], pB[200005], F[M], G[M];
int n, cx, cy;
long long D;
long long C(long long *a, long long *p, long long x) {
    int k = lower_bound(a, a + n, x) - a;
    long long L = k > 0 ? p[k - 1] : 0, s = 0;
    if (k > 0)
        s += (long long)k * x - L;
    if (k < n)
        s += p[n - 1] - L - (long long)(n - k) * x;
    return s;
}
int main() {
    ios::sync_with_stdio(false);
    cin.tie(0);
    cin >> n >> D;
    for (int i = 0; i < n; i++)
        cin >> A[i] >> B[i];
    sort(A, A + n);
    sort(B, B + n);
    pA[0] = A[0];
    pB[0] = B[0];
    for (int i = 1; i < n; i++)
        pA[i] = pA[i - 1] + A[i], pB[i] = pB[i - 1] + B[i];
    for (long long x = A[n - 1] - D; x <= A[0] + D; x++) {
        long long v = C(A, pA, x);
        if (v <= D)
            F[cx++] = v;
    }
    for (long long y = B[n - 1] - D; y <= B[0] + D; y++) {
        long long v = C(B, pB, y);
        if (v <= D)
            G[cy++] = v;
    }
    sort(F, F + cx);
    sort(G, G + cy);
    long long ans = 0;
    for (int i = 0, j = cy - 1; i < cx; i++) {
        while (j >= 0 && F[i] + G[j] > D)
            j--;
        if (j < 0)
            break;
        ans += j + 1;
    }
    cout << ans;
}
\end{lstlisting}
\end{codebox}

\noindent 判断题\\
\qdot{16.} 函数 C 的功能是计算所有 \texttt{|A[i]-x|} 的和，即数组 A 中所有元素与 x 的距离之和。（\qquad）\\
\opt{A. 正确}
\opt{B. 错误}
\qdot{17.} 若将枚举 x 的循环改为从 \texttt{A[0]-D} 到 \texttt{A[n-1]+D}（其余部分不变），程序的输出一定发生改变。（\qquad）\\
\opt{A. 正确}
\opt{B. 错误}
\qdot{18.} 当 \texttt{x < A[0]-D} 时，不可能有满足 \texttt{sum(|A[i]-x|) <= D} 的 x，因此枚举 x 从 \texttt{A[n-1]-D} 开始是充分的。（\qquad）\\
\opt{A. 正确}
\opt{B. 错误}

\noindent 单选题\\
\qdot{19.} 函数 C 中 k = \texttt{lower\_bound(a, a+n, x) - a} 表示（\qquad）\\
\opt{A. a 中小于 x 的元素个数}
\opt{B. a 中不大于 x 的元素个数}
\opt{C. a 中等于 x 的元素个数}
\opt{D. a 中大于 x 的元素个数}
\qdot{20.} 当输入为\\
\hspace*{2em} \texttt{2 3}\\
\hspace*{2em} \texttt{0 0}\\
\hspace*{2em} \texttt{1 0}\\
\hspace*{1em} 时，程序的输出为（\qquad）\\
\opt{A. 6}
\opt{B. 7}
\opt{C. 8}
\opt{D. 10}

\clearpage
\noindent（2）
\begin{codebox}
\begin{lstlisting}
#include <bits/stdc++.h>
using namespace std;
const int N = 6e2 + 5;
int g[N][N], w[N], v[N], id[N], n, m;
int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    cin >> n >> m;
    for (int i = 1; i <= n; ++i)
        id[i] = i;
    for (int i = 0, x, y, z; i < m; ++i) {
        cin >> x >> y >> z;
        g[x][y] += z;
        g[y][x] += z;
    }
    int ans = n < 2 ? 0 : 2e9, cur = n;
    while (cur > 1) {
        memset(w, 0, sizeof(w));
        memset(v, 0, sizeof(v));
        int p = 0, u = 0;
        for (int i = 1; i <= cur; ++i) {
            u = -1;
            for (int j = 1; j <= cur; ++j)
                if (!v[id[j]] && (u == -1 || w[id[j]] > w[u]))
                    u = id[j];
            v[u] = 1;
            if (i == cur) {
                if (w[u] < ans)
                    ans = w[u];
                for (int j = 1; j <= cur; ++j) {
                    int t = id[j];
                    if (t != u)
                        g[p][t] += g[u][t], g[t][p] += g[t][u];
                }
                for (int j = 1; j <= cur; ++j)
                    if (id[j] == u) {
                        id[j] = id[cur];
                        break;
                    }
                --cur;
            } else {
                p = u;
                for (int j = 1; j <= cur; ++j)
                    if (!v[id[j]])
                        w[id[j]] += g[u][id[j]];
            }
        }
    }
    cout << ans;
}
\end{lstlisting}
\end{codebox}

\noindent 判断题\\
\qdot{21.} 该程序求出的是无向连通图的全局最小割（删去后使图不再连通的最小边权和）。（\qquad）\\
\opt{A. 正确}
\opt{B. 错误}
\qdot{22.} 当输入的 n=1 时，程序的输出为 0。（\qquad）\\
\opt{A. 正确}
\opt{B. 错误}
\qdot{23.} 主循环 \texttt{while (cur > 1)} 恰好执行 n 轮。（\qquad）\\
\opt{A. 正确}
\opt{B. 错误}

\noindent 单选题\\
\qdot{24.} 在每一轮循环中，最后被加入集合的顶点 u 对应的 \texttt{w[u]} 表示（\qquad）\\
\opt{A. u 与所有未加入集合的顶点之间的边权和}
\opt{B. u 与已加入集合的顶点之间的边权和（即当前划分的割的大小）}
\opt{C. u 的度数}
\opt{D. u 与上一个加入集合的顶点之间的边权和}
\qdot{25.} 该算法的时间复杂度为（\qquad）\\
\opt{A. \texttt{O(n\^{}2)}}
\opt{B. \texttt{O(n\^{}3)}}
\opt{C. \texttt{O(nm)}}
\opt{D. \texttt{O(m log n)}}
\qdot{26.} 当输入为\\
\hspace*{2em} \texttt{4 6}\\
\hspace*{2em} \texttt{1 2 5}\\
\hspace*{2em} \texttt{1 3 1}\\
\hspace*{2em} \texttt{2 4 1}\\
\hspace*{2em} \texttt{3 4 2}\\
\hspace*{2em} \texttt{2 3 1}\\
\hspace*{2em} \texttt{1 4 2}\\
\hspace*{1em} 时，程序的输出为（\qquad）\\
\opt{A. 3}
\opt{B. 4}
\opt{C. 5}
\opt{D. 6}

\clearpage
\noindent（3）
\begin{codebox}
\begin{lstlisting}
#include <bits/stdc++.h>
using namespace std;

const int N = 8e5 + 5;

struct Q {
    int t, op, x, y, id;
    long long v;
} q[N], p[N];

int n, m, tot, qc, a[N];
long long c[N], ans[N];
set<int> S[N];

void add(int x, long long v) {
    for (; x; x -= x & -x)
        c[x] += v;
}

long long ask(int x) {
    long long s = 0;
    for (; x < N; x += x & -x)
        s += c[x];
    return s;
}

void add_e(int u, int v, int w) {
    if (u && v)
        q[++tot] = {tot, 0, v, u, 0, 1LL * w * (v - u)};
}

void cdq(int l, int r) {
    if (l >= r)
        return;
    int m = (l + r) / 2;
    cdq(l, m);
    cdq(m + 1, r);
    int j = l;
    for (int i = m + 1; i <= r; ++i) {
        if (q[i].op) {
            while (j <= m && q[j].x <= q[i].x) {
                if (!q[j].op)
                    add(q[j].y, q[j].v);
                j++;
            }
            ans[q[i].id] += ask(q[i].y);
        }
    }
    for (int k = l; k < j; ++k)
        if (!q[k].op)
            add(q[k].y, -q[k].v);
    int i = l, k = l;
    j = m + 1;
    while (i <= m && j <= r)
        p[k++] = (q[i].x <= q[j].x ? q[i++] : q[j++]);
    while (i <= m)
        p[k++] = q[i++];
    while (j <= r)
        p[k++] = q[j++];
    for (i = l; i <= r; ++i)
        q[i] = p[i];
}

int main() {
    cin.tie(0)->sync_with_stdio(0);
    cin >> n >> m;
    for (int i = 1; i <= n; ++i) {
        cin >> a[i];
        S[a[i]].insert(i);
    }
    for (int i = 1; i <= n; ++i) {
        int pr = 0;
        for (int x : S[i]) {
            add_e(pr, x, 1);
            pr = x;
        }
    }
    while (m--) {
        int op, x, y;
        cin >> op >> x >> y;
        if (op == 1) {
            if (a[x] == y)
                continue;
            int c1 = a[x], c2 = y;
            auto it = S[c1].find(x);
            int pr = (it == S[c1].begin() ? 0 : *prev(it));
            auto nit = next(it);
            int nx = (nit == S[c1].end() ? 0 : *nit);
            add_e(pr, x, -1);
            add_e(x, nx, -1);
            add_e(pr, nx, 1);
            S[c1].erase(it);

            S[c2].insert(x);
            it = S[c2].find(x);
            pr = (it == S[c2].begin() ? 0 : *prev(it));
            nit = next(it);
            nx = (nit == S[c2].end() ? 0 : *nit);
            add_e(pr, nx, -1);
            add_e(pr, x, 1);
            add_e(x, nx, 1);
            a[x] = y;
        } else {
            q[++tot] = {tot, 1, y, x, ++qc, 0};
        }
    }
    cdq(1, tot);
    for (int i = 1; i <= qc; ++i)
        cout << ans[i] << "\n";
}
\end{lstlisting}
\end{codebox}

\noindent 判断题\\
\qdot{27.} 该程序采用 CDQ 分治的方法，离线处理所有的修改与查询操作。（\qquad）\\
\opt{A. 正确}
\opt{B. 错误}
\qdot{28.} 函数 ask(x) 查询的是树状数组中所有下标不大于 x 的位置的元素之和。（\qquad）\\
\opt{A. 正确}
\opt{B. 错误}
\qdot{29.} 若查询区间 [l, r] 内某种形状恰好出现一次，则该形状对该区间记忆值的贡献为 0。（\qquad）\\
\opt{A. 正确}
\opt{B. 错误}

\noindent 单选题\\
\qdot{30.} 函数 add\_e(u, v, w) 中 if (u \&\& v) 的作用是（\qquad）\\
\opt{A. 仅当 u 与 v 均非 0 时，才生成一个事件}
\opt{B. 当 u 与 v 中至少一个为 0 时，生成一个事件}
\opt{C. 当 u 与 v 相等时，生成一个事件}
\opt{D. 当 u 与 v 均非 0 时，不生成事件}
\qdot{31.} 该程序 CDQ 分治部分的时间复杂度约为（\qquad）\\
\opt{A. \texttt{O(n+m)}}
\opt{B. \texttt{O((n+m) log(n+m))}}
\opt{C. \texttt{O((n+m) log\^{}2(n+m))}}
\opt{D. \texttt{O((n+m)\^{}2)}}
\qdot{32.} 当输入为\\
\hspace*{2em} \texttt{7 6}\\
\hspace*{2em} \texttt{1 2 3 1 3 2 1}\\
\hspace*{2em} \texttt{2 3 7}\\
\hspace*{2em} \texttt{2 1 3}\\
\hspace*{2em} \texttt{1 7 2}\\
\hspace*{2em} \texttt{1 3 2}\\
\hspace*{2em} \texttt{2 1 6}\\
\hspace*{2em} \texttt{2 5 7}\\
\hspace*{1em} 时，第一个查询的输出为（\qquad）\\
\opt{A. 3}
\opt{B. 5}
\opt{C. 7}
\opt{D. 9}

\clearpage
% ======================== 三、完善程序 ========================
\bigtitle{三、完善程序（单选题，每小题 3 分，共计 30 分）}

\noindent（1）（矩阵变换） 给出一个 \texttt{N} 行 \texttt{M} 列的矩阵 \texttt{A}，满足：① \texttt{M > N}；② 矩阵中每个数都是 \texttt{[0, N]} 中的自然数；③ 每行中 \texttt{[1, N]} 中每个自然数恰好出现一次（因此每行中 0 恰好出现 \texttt{M-N} 次）；④ 每列中 \texttt{[1, N]} 中每个自然数至多出现一次。现在要在每行中选取一个非零数，并把这个数之后的数都赋值为这个数，希望在操作后性质④仍然成立。若存在方案，输出每行选取的数（应为 1 到 N 的一个排列）；否则输出任意卖萌表情。上述参数满足 \texttt{N <= 200}，\texttt{M < 400}，\texttt{T < 50}。\\

提示：该问题可转化为稳定婚姻问题——每行与每个数字作为两类参与者，行 \texttt{i} 按数字 \texttt{x} 在该行中出现的位置 \texttt{p[i][x]} 从小到大排序，数字 \texttt{v} 按其在各行中位置从大到小排序；再用队列依次尝试匹配，发生冲突时按双方偏好决定替换谁。

\begin{codebox}
\begin{lstlisting}
#include <bits/stdc++.h>
using namespace std;
const int E = 4e2 + 5, Q = 4e4 + 5;
int n, m, a[E][E], p[E][E], pr[E][E], pn[E][E], rk[E][E], rn[E][E], mt[E],
    mn[E], q[Q], ptr[E];
int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    int T;
    cin >> T;
    while (T--) {
        cin >> n >> m;
        for (int i = 1; i <= n; ++i)
            for (int j = 1; j <= m; ++j) {
                cin >> a[i][j];
                if (a[i][j])
                    p[i][a[i][j]] = j;
            }
        for (int i = 1; i <= n; ++i) {
            iota(pr[i] + 1, pr[i] + n + 1, 1);
            sort(pr[i] + 1, pr[i] + n + 1,
                 [&](int x, int y) { return |@\blank{①}@|; });
            pr[i][n + 1] = 0;
        }
        for (int v = 1; v <= n; ++v) {
            iota(pn[v] + 1, pn[v] + n + 1, 1);
            sort(pn[v] + 1, pn[v] + n + 1,
                 [&](int i, int j) { return |@\blank{②}@|; });
            for (int k = 1; k <= n; ++k)
                |@\blank{③}@|;
        }
        fill(mt + 1, mt + n + 1, 0);
        fill(mn + 1, mn + n + 1, 0);
        fill(ptr + 1, ptr + n + 1, 1);
        int h = 0, t = 0, ok = 1;
        for (int i = 1; i <= n; ++i)
            q[t++] = i;
        while (h < t) {
            int i = q[h++], v = pr[i][ptr[i]++];
            if (!v) {
                ok = 0;
                break;
            }
            if (!mn[v]) {
                mn[v] = i;
                mt[i] = v;
            } else {
                int j = mn[v];
                if (|@\blank{④}@|) {
                    mn[v] = i;
                    mt[i] = v;
                    mt[j] = 0;
                    |@\blank{⑤}@|;
                } else
                    q[t++] = i;
            }
        }
        if (!ok)
            cout << "(^o^)/\n";
        else
            for (int i = 1; i <= n; ++i)
                cout << mt[i] << " \n"[i == n];
    }
}
\end{lstlisting}
\end{codebox}

\q{33.} ①处应填（\qquad）\\
\optw{A. \texttt{return p[i][x] < p[i][y];}}{B. \texttt{return p[i][x] > p[i][y];}}
\optw{C. \texttt{return p[i][x] == p[i][y];}}{D. \texttt{return p[i][x] - p[i][y];}}

\q{34.} ②处应填（\qquad）\\
\optw{A. \texttt{return p[i][v] < p[j][v];}}{B. \texttt{return p[i][v] > p[j][v];}}
\optw{C. \texttt{return p[i][v] == p[j][v];}}{D. \texttt{return p[i][v] - p[j][v];}}

\q{35.} ③处应填（\qquad）\\
\optw{A. \texttt{rn[v][pn[v][k]] = k;}}{B. \texttt{rn[v][k] = pn[v][k];}}
\optw{C. \texttt{rn[pn[v][k]][v] = k;}}{D. \texttt{rn[v][pn[v][k]] = pn[v][k];}}

\q{36.} ④处应填（\qquad）\\
\optw{A. \texttt{if (rn[v][i] < rn[v][j])}}{B. \texttt{if (rn[v][i] > rn[v][j])}}
\optw{C. \texttt{if (rn[v][i] == rn[v][j])}}{D. \texttt{if (rn[i][v] < rn[j][v])}}

\q{37.} ⑤处应填（\qquad）\\
\optw{A. \texttt{q[t++] = i;}}{B. \texttt{q[t++] = j;}}
\optw{C. \texttt{q[h++] = j;}}{D. \texttt{q[t] = j;}}

\clearpage
\noindent（2）（树上咒语相撞） 给定一棵 \texttt{n} 个结点的树（结点编号 1 到 n），其中有 \texttt{n-1} 条无向道路。问有多少个三元组 \texttt{(u, v, w)} 满足：\texttt{u}、\texttt{v}、\texttt{w} 互不相同，且存在从 \texttt{u} 到 \texttt{w} 与从 \texttt{v} 到 \texttt{w} 的两条路径，这两条路径不经过相同的道路（即 \texttt{w} 是 \texttt{u} 到 \texttt{v} 路径上的中间点，且 \texttt{u}、\texttt{v} 位于 \texttt{w} 的不同分支）。同时，会不断在树中加入新边（新边可能连接已存在的结点对，也可能连接同一个结点自身），每加入一条新边后，需要输出当前满足条件的三元组个数。上述参数满足 \texttt{n, q <= 10\^{}5}。\\

提示：三元组计数可按 \texttt{w} 分类：\texttt{u}、\texttt{v} 必须落在 \texttt{w} 的不同的相邻分支中。加边后，环上的点会被并查集合并成一个分量，维护每个分量的大小 \texttt{z} 与"锚点子树"大小 \texttt{u}，并利用原树信息 \texttt{s} 更新答案。

\begin{codebox}
\begin{lstlisting}
#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
const int E = 1e5 + 5;
int n, hd[E], to[E * 2], ne[E * 2], cnt, fa[E], dep[E], sz[E], f[E];
ll z[E], s[E], u[E], ans;
void add(int x, int y) { to[++cnt] = y, ne[cnt] = hd[x], hd[x] = cnt; }
void dfs(int x, int p) {
    fa[x] = p, dep[x] = dep[p] + 1, sz[x] = 1;
    for (int i = hd[x]; i; i = ne[i])
        if (to[i] != p)
            dfs(to[i], x), |@\blank{①}@|;
}
int find(int x) { return f[x] == x ? x : f[x] = find(f[x]); }
void merge(int x, int y) {
    x = find(x), y = find(y);
    if (x == y)
        return;
    ll cx = z[x], cy = z[y], tx = u[x], ty = n - tx;
    ans -= cx * (cx - 1) * (cx - 2) + 2 * cx * (cx - 1) * (n - cx) + cx * ((n - cx) * (n - cx) - s[x]);
    ans -= cy * (cy - 1) * (cy - 2) + 2 * cy * (cy - 1) * (n - cy) + cy * ((n - cy) * (n - cy) - s[y]);
    s[y] = s[y] - tx * tx + s[x] - ty * ty;
    |@\blank{⑤}@|;
    f[x] = y;
    cx = z[y];
    ans += cx * (cx - 1) * (cx - 2) + 2 * cx * (cx - 1) * (n - cx) + cx * ((n - cx) * (n - cx) - s[y]);
}
int main() {
    ios::sync_with_stdio(0);
    cin.tie(0);
    cin >> n;
    for (int i = 1; i < n; ++i) {
        int x, y;
        cin >> x >> y;
        add(x, y);
        add(y, x);
    }
    dfs(1, 0);
    for (int i = 1; i <= n; ++i)
        f[i] = i, z[i] = 1, |@\blank{③}@|;
    for (int i = 1; i <= n; ++i) {
        ll t = 0;
        for (int j = hd[i]; j; j = ne[j])
            if (to[j] != fa[i])
                t += |@\blank{②}@|;
        if (fa[i])
            t += 1ll * (n - sz[i]) * (n - sz[i]);
        s[i] = t;
    }
    for (int i = 1; i <= n; ++i) {
        ll c = z[i];
        ans += c * (c - 1) * (c - 2) + 2 * c * (c - 1) * (n - c) + c * ((n - c) * (n - c) - s[i]);
    }
    cout << ans << '\n';
    int q;
    cin >> q;
    while (q--) {
        int x, y;
        cin >> x >> y;
        x = find(x), y = find(y);
        while (x != y) {
            if (|@\blank{④}@|)
                swap(x, y);
            int p = find(fa[x]);
            merge(x, p);
            x = find(x);
        }
        cout << ans << '\n';
    }
}
\end{lstlisting}
\end{codebox}

\q{38.} ①处应填（\qquad）\\
\optw{A. \texttt{sz[x] += sz[x];}}{B. \texttt{sz[x] += sz[to[i]];}}
\optw{C. \texttt{sz[to[i]] += sz[x];}}{D. \texttt{sz[x] = sz[to[i]];}}

\q{39.} ②处应填（\qquad）\\
\optw{A. \texttt{t += sz[to[j]] * sz[to[j]];}}{B. \texttt{t += 1ll * sz[to[j]] * sz[to[j]];}}
\optw{C. \texttt{t += 1ll * sz[to[j]] * sz[to[i]];}}{D. \texttt{t += 1ll * sz[i] * sz[to[j]];}}

\q{40.} ③处应填（\qquad）\\
\optw{A. \texttt{u[i] = i;}}{B. \texttt{u[i] = sz[i];}}
\optw{C. \texttt{u[i] = dep[i];}}{D. \texttt{u[i] = n;}}

\q{41.} ④处应填（\qquad）\\
\optw{A. \texttt{if (dep[x] < dep[y]) swap(x, y);}}{B. \texttt{if (dep[x] > dep[y]) swap(x, y);}}
\optw{C. \texttt{if (sz[x] < sz[y]) swap(x, y);}}{D. \texttt{if (fa[x] < fa[y]) swap(x, y);}}

\q{42.} ⑤处应填（\qquad）\\
\optw{A. \texttt{z[y] += z[x];}}{B. \texttt{z[x] += z[y];}}
\optw{C. \texttt{z[y] = z[x];}}{D. \texttt{f[y] = x;}}

